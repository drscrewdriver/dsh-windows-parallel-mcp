{
  "name": "dsh-windows-parallel-mcp",
  "version": "0.4.1",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Drive a Windows window quietly by default and visibly on request: one tool, five actions, a channel decision table that prefers the quiet door, a bounded self-reversing focus flash when only UI Automation can reach the control, and an opt-in takeover tier (HUD mandatory, cursor always restored, keyboard injection only when asked and only for the foreground target). Windows PowerShell 5.1 sidecar, zero install dependencies, no mouse injection.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "windows",
    "parallel",
    "hwnd",
    "ui-automation",
    "computer-use"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-windows-parallel-mcp.git"
  },
  "homepage": "https://github.com/drscrewdriver/dsh-windows-parallel-mcp#readme",
  "bugs": {
    "url": "https://github.com/drscrewdriver/dsh-windows-parallel-mcp/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": { "types": "./types/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh.plugin.json": "./dsh.plugin.json",
    "./src/engine/*": "./src/engine/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "types/",
    "src/engine/",
    "src/schema/",
    "docs/refusals.md",
    "docs/takeover.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "INSTALL.md",
    "README.md",
    "INSTALL.ru.md",
    "CHANGELOG.ru.md",
    "README.ru.md",
    "INSTALL.pt.md",
    "CHANGELOG.pt.md",
    "README.pt.md",
    "INSTALL.es.md",
    "CHANGELOG.es.md",
    "README.es.md",
    "INSTALL.it.md",
    "CHANGELOG.it.md",
    "README.it.md",
    "INSTALL.de.md",
    "CHANGELOG.de.md",
    "README.de.md",
    "INSTALL.fr.md",
    "CHANGELOG.fr.md",
    "README.fr.md",
    "INSTALL.ko.md",
    "CHANGELOG.ko.md",
    "README.ko.md",
    "INSTALL.ja.md",
    "CHANGELOG.ja.md",
    "README.ja.md",
    "INSTALL.zh.md",
    "CHANGELOG.zh.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.7-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node test/plugin-test.mjs && node test/worker-smoke.mjs",
    "test:decide": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File test/decide-test.ps1",
    "test:refusals": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File test/refusals-test.ps1",
    "test:hud": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -STA -File test/hud-test.ps1",
    "test:takeover": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -STA -File test/takeover-test.ps1",
    "test:keyinject": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -STA -File test/keyinject-test.ps1",
    "smoke:installed": "node test/smoke-installed.mjs",
    "prepack": "node scripts/check-pack.mjs",
    "verify:install": "node scripts/verify-install.mjs"
  }
}
